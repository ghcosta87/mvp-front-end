/* =========================================
   1. VARIÁVEIS GLOBAIS E TEMAS
========================================= */
/* Tema 1: Claro (Padrão) */
:root {
    --bg-page: #f4f6f9;
    --bg-card: #ffffff;
    --text-main: #333333;
    --text-muted: #6c757d;
    --border-color: #dee2e6;
    
    /* Cores dos Botões */
    --btn-primary: #0d6efd; 
    --btn-success: #198754;
    --btn-danger: #dc3545;
}

/* Tema 2: Escuro */
[data-theme="escuro"] {
    --bg-page: #121212;
    --bg-card: #1e1e1e;
    --text-main: #e0e0e0;
    --text-muted: #9e9e9e;
    --border-color: #333333;

    --btn-primary: #3700b3; 
    --btn-success: #03dac6; /* Verde Neon */
    --btn-danger: #cf6679;
}

/* Tema 3: Tech/Moderno (Roxo Suave) */
[data-theme="tech"] {
    --bg-page: #f3f0ff;
    --bg-card: #ffffff;
    --text-main: #2b1d38;
    --text-muted: #857b92;
    --border-color: #d8cce6;

    --btn-primary: #6f42c1; /* Roxo Bootstrap */
    --btn-success: #20c997; /* Verde Água */
    --btn-danger: #e83e8c;  /* Rosa/Magenta */
}

/* Tema Tech - Azul Metalizado */
body.tech-mode {
    background: linear-gradient(135deg, #060b14 0%, #0d1b33 50%, #091224 100%) !important;
    color: #e2e8f0 !important;
    min-height: 100vh;
}

body.tech-mode .card, 
body.tech-mode .modal-content,
body.tech-mode .list-group-item {
    background-color: #0f1c35 !important;
    color: #e2e8f0 !important;
    border: 1px solid #1e3a8a !important;
    box-shadow: 0 0 15px rgba(37, 99, 235, 0.15);
}

body.tech-mode .form-control {
    background-color: #091326 !important;
    color: #ffffff !important;
    border: 1px solid #2563eb !important;
}

body.tech-mode .form-control:focus {
    border-color: #60a5fa !important;
    box-shadow: 0 0 10px rgba(96, 165, 250, 0.4) !important;
}

/* Botões com efeito metálico azul */
body.tech-mode .btn-primary, 
body.tech-mode button[id*="camera"],
body.tech-mode label[for="input-comprovante"] {
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 50%, #1e40af 100%) !important;
    border: 1px solid #60a5fa !important;
    color: #ffffff !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 4px 10px rgba(29, 78, 216, 0.4);
}

body.tech-mode .btn-primary:hover {
    background: linear-gradient(180deg, #60a5fa 0%, #2563eb 50%, #1d4ed8 100%) !important;
}

body.tech-mode .btn-warning {
    background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%) !important;
    border: 1px solid #fbbf24 !important;
    color: #ffffff !important;
}

/* =========================================
   2. APLICANDO AS VARIÁVEIS AO PROJETO
========================================= */
body {
    background-color: var(--bg-page);
    color: var(--text-main);
    transition: background-color 0.3s, color 0.3s;
}

.card, .resultado-box, .list-group-item {
    background-color: var(--bg-card) !important;
    color: var(--text-main);
    border-color: var(--border-color) !important;
}

.text-price {
    color: var(--btn-success) !important;
}

/* Cores dinâmicas para os botões */
.btn-primary { background-color: var(--btn-primary); border-color: var(--btn-primary); }
.btn-success { background-color: var(--btn-success); border-color: var(--btn-success); }
.btn-danger { background-color: var(--btn-danger); border-color: var(--btn-danger); }

/* =========================================
   3. SIMETRIA DA CÂMERA E DA INTERFACE
========================================= */
.camera-box {
    width: 100%;
    max-width: 400px; /* Não deixa a câmera ficar gigante no PC */
    aspect-ratio: 4/3; /* Formato clássico de foto */
    background-color: #000;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 2px solid var(--border-color);
}

.camera-box video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Preenche a caixa sem distorcer a imagem */
}


/* ==========================================
   VARIÁVEIS DE TEMA (Obrigatório para o Modal)
=========================================== */
:root {
    --bg-card: #ffffff;
    --text-main: #333333;
    --border-color: #dee2e6;
    --btn-primary: #3b71ca;
}

[data-theme="escuro"] {
    --bg-card: #212529;
    --text-main: #f8f9fa;
    --border-color: #373b3e;
    --btn-primary: #54b4d3;
}

[data-theme="tech"] {
    --bg-card: #12121f;
    --text-main: #00ffcc;
    --border-color: #1f1f38;
    --btn-primary: #00ffcc;
}

/* A Cortina que cobre a tela toda */
#tela-loading {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background-color: var(--cor-fundo, #f4f6f9); /* Cor de fundo do site */
    display: flex;
    justify-content: center; align-items: center;
    z-index: 9999; /* Fica acima de qualquer outro elemento */
    opacity: 0; 
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s;
}

/* Classe que o JavaScript vai usar para ligar/desligar a cortina */
.loading-ativo {
    opacity: 1 !important;
    visibility: visible !important;
}

/* O círculo giratório (Spinner puro em CSS) */
.spinner {
    width: 50px; height: 50px;
    border: 5px solid #ccc;
    border-top-color: #0d6efd; /* Azul do Bootstrap */
    border-radius: 50%;
    animation: girar 1s linear infinite;
}

@keyframes girar {
    to { transform: rotate(360deg); }
}
/* Garante fundo sólido e opaco no conteúdo do modal */
.modal-content {
    background-color: var(--bg-card) !important;
    color: var(--text-main) !important;
    opacity: 1 !important;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4) !important;
    border: 1px solid var(--border-color) !important;
}

/* Força os itens da lista de histórico dentro do modal a acompanharem o tema */
.modal-content .list-group-item {
    background-color: transparent !important;
    color: var(--text-main) !important;
    border-color: var(--border-color) !important;
}

/* Garante o fundo escuro de trás (backdrop) */
.modal-backdrop {
    background-color: rgba(0, 0, 0, 0.6) !important;
    opacity: 1 !important;
}